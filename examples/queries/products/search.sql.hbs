{{!--
  Handlebars template: every {{value}} becomes a bound parameter.
  POST /api/products/search  {"categories": ["coffee"], "max_price": 20, "sort": "price"}
--}}
SELECT id, name, category, price
FROM products
WHERE 1 = 1
{{#if categories}}
  AND category IN ({{#each categories}}{{this}}{{#unless @last}}, {{/unless}}{{/each}})
{{/if}}
{{#if max_price}}
  AND price <= {{max_price}}
{{/if}}
{{#if in_stock}}
  AND in_stock
{{/if}}
ORDER BY {{ident sort allow="id,name,price"}} {{#if desc}}DESC{{else}}ASC{{/if}}
